curl -s "https://api.github.com/repos/anas4u02/github-final-project/pulls?state=all" \
  | jq '.[] | {
      pr_number: .number,
      title: .title,
      state: .state,
      is_valid_pr: (if .state == "open" or .state == "closed" then true else false end),
      target_repo: .base.repo.full_name,
      forked_from_repo: .head.repo.full_name,
      from_branch: .head.ref,
      into_branch: .base.ref
    }'